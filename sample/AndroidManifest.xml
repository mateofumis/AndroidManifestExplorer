<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.manifestexploitable.app"
    android:sharedUserId="com.manifestexploitable.shared">

    <!-- Dangerous permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Harmless permissions (should NOT be flagged) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:testOnly="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="ManifestExploitable">

        <!-- ══════════════════════════════════════════════════
             ACTIVITIES
        ══════════════════════════════════════════════════ -->

        <!-- Launcher activity (exported via intent-filter, no permission) -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explicitly exported activity, no permission -->
        <activity
            android:name=".TransferActivity"
            android:exported="true" />

        <!-- Deep link activity: two intent-filters with scheme + host + path -->
        <activity
            android:name=".DeepLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="manifestexploitable"
                    android:host="open"
                    android:pathPrefix="/transfer" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="manifestexploitable.com" />
                <data android:pathPattern="/account/.*" />
            </intent-filter>
        </activity>

        <!-- Exported activity with a custom permission -->
        <activity
            android:name=".AdminPanelActivity"
            android:exported="true"
            android:permission="com.manifestexploitable.app.ACCESS_ACCOUNTS" />

        <!-- Disabled activity — must NOT appear in output -->
        <activity
            android:name=".HiddenDebugActivity"
            android:exported="true"
            android:enabled="false" />

        <!-- ══════════════════════════════════════════════════
             BROADCAST RECEIVERS
        ══════════════════════════════════════════════════ -->

        <!-- Exported receiver via intent-filter, no permission -->
        <receiver android:name=".SmsInterceptReceiver">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Explicitly exported receiver, no permission -->
        <receiver
            android:name=".AdminCommandReceiver"
            android:exported="true" />

        <!-- ══════════════════════════════════════════════════
             SERVICES
        ══════════════════════════════════════════════════ -->

        <!-- Exported service via intent-filter, no permission -->
        <service android:name=".DataSyncService">
            <intent-filter>
                <action android:name="com.manifestexploitable.app.action.SYNC" />
            </intent-filter>
        </service>

        <!-- Explicitly exported service with permission -->
        <service
            android:name=".RemoteControlService"
            android:exported="true"
            android:permission="com.manifestexploitable.app.VIEW_TRANSACTIONS" />

        <!-- ══════════════════════════════════════════════════
             CONTENT PROVIDERS
        ══════════════════════════════════════════════════ -->

        <!-- Exported provider: grantUriPermissions + path-permission elements -->
        <provider
            android:name=".AccountsProvider"
            android:authorities="com.manifestexploitable.app.accounts"
            android:exported="true"
            android:grantUriPermissions="true">
            <path-permission
                android:pathPrefix="/transactions"
                android:readPermission="com.manifestexploitable.app.VIEW_TRANSACTIONS" />
            <path-permission
                android:path="/admin"
                android:readPermission="com.manifestexploitable.app.ACCESS_ACCOUNTS"
                android:writePermission="com.manifestexploitable.app.ACCESS_ACCOUNTS" />
        </provider>

        <!-- Exported provider with read permission -->
        <provider
            android:name=".UserDataProvider"
            android:authorities="com.manifestexploitable.app.userdata"
            android:exported="true"
            android:readPermission="com.manifestexploitable.app.ACCESS_ACCOUNTS" />

    </application>

</manifest>
